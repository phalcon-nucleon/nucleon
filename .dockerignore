# Not copied into the image: the dependencies are installed by the Dockerfile (--no-dev), the compiled files
# generated by `php quark optimize`.
.git
.github
.idea
vendor
tests
phpunit.xml
.phpunit.cache
_ide_helper.php
.phpstorm.meta.php
bootstrap/compile/*
!bootstrap/compile/.gitkeep
storage/caches/*
storage/logs/*
storage/sessions/*
storage/views/*
!storage/*/.gitignore
